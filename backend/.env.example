# Choose a provider: gemini (default) or groq (any OpenAI-compatible endpoint works, see LLM_BASE_URL)
LLM_PROVIDER=gemini

# Gemini (free key: https://aistudio.google.com/apikey). Default model: gemini-2.5-flash
GEMINI_API_KEY=

# Groq (free key: https://console.groq.com/keys). Default model: openai/gpt-oss-120b
GROQ_API_KEY=

# Optional overrides
# LLM_MODEL=
# LLM_BASE_URL=https://api.groq.com/openai/v1   # e.g. http://localhost:11434/v1 for Ollama
